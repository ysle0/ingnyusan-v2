package templates

import (
	"fmt"
	"blog/internal/parser"
)

templ HomePage(siteName string, posts []parser.Post) {
	@layout(siteName) {
		<h2>Recent Posts</h2>
		@postList(posts)
	}
}

templ MePage(siteName string) {
	@layout(siteName + " - About Me") {
		<h2>About Me</h2>
		<p>Based on <a href="https://github.com/ysle0" target="_blank">https://github.com/ysle0</a></p>
		
		<div class="profile">
			<h3>GitHub Profile</h3>
			<div id="github-profile" hx-get="/api/github-profile" hx-trigger="load" hx-swap="innerHTML">
				<p>Loading profile information...</p>
			</div>
		</div>
	}
}

templ PortfolioPage(siteName string) {
	@layout(siteName + " - Portfolio") {
		<h2>Portfolio</h2>
		<p>Coming soon...</p>
	}
}

templ BooksPage(siteName string, posts []parser.Post) {
	@layout(siteName + " - Book Reviews") {
		<h2>Book Reviews</h2>
		if len(posts) > 0 {
			@postList(posts)
		} else {
			<p>No book reviews yet.</p>
		}
	}
}

templ LanguagesPage(siteName string) {
	@layout(siteName + " - Languages") {
		<h2>Languages</h2>
		<p>Coming soon...</p>
	}
}

templ ToolsPage(siteName string) {
	@layout(siteName + " - Developer Tools") {
		<h2>Developer Tools</h2>
		<ul>
			<li><a href="/tools/bitwise">Bitwise Operation Calculator</a></li>
			<li><a href="/tools/jwt">JWT Inspector</a></li>
			<li><a href="/tools/currency">Currency Calculator</a></li>
		</ul>
		<p>More tools coming soon...</p>
	}
}

templ PostPage(siteName string, post parser.Post) {
	@layout(siteName + " - " + post.Title) {
		<article>
			<header>
				<h2>{ post.Title }</h2>
				<div class="post-meta">
					<span class="date">{ formatDate(post.Date) }</span>
					<span class="time-to-read">{ fmt.Sprintf("%d", post.TimeToRead) } min read</span>
				</div>
				<div class="tags">
					for _, tag := range post.Tags {
						<span class="tag">{ tag }</span>
					}
				</div>
			</header>
			
			<div class="post-content">
				@templ.Raw(post.Content)
			</div>
		</article>
	}
}

templ EditorPage(siteName string) {
	@layout(siteName + " - Post Editor") {
		<h2>Post Editor</h2>
		<div class="editor-container">
			<div class="editor-form">
				<form hx-post="/api/save-post" hx-swap="none" hx-trigger="submit">
					<div class="form-group">
						<label for="title">Title</label>
						<input type="text" id="title" name="title" required />
					</div>
					
					<div class="form-group">
						<label for="description">Description</label>
						<input type="text" id="description" name="description" required />
					</div>
					
					<div class="form-group">
						<label for="tags">Tags (comma separated)</label>
						<input type="text" id="tags" name="tags" />
					</div>
					
					<div class="form-group">
						<label for="slug">Slug</label>
						<input type="text" id="slug" name="slug" required />
					</div>
					
					<div class="form-group">
						<label for="content">Content</label>
						<textarea id="content" name="content" rows="20" hx-post="/api/preview" hx-trigger="keyup changed delay:500ms" hx-target="#preview"></textarea>
					</div>
					
					<button type="submit">Save Post</button>
				</form>
			</div>
			
			<div class="editor-preview">
				<h3>Preview</h3>
				<div id="preview"></div>
			</div>
		</div>
	}
} 